// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?  // The ID of the user from your Main Supabase DB (crucial for syncing)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// 1. Unique User Likes per Story
model StoryLike {
  id        String   @id @default(cuid())
  storyId   String   // Sanity story ID or slug
  userId    String   // Supabase auth user UUID
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

// 2. Deduplicated 24-Hour Views
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String?
  viewHash  String   // SHA-256 hash for daily deduplication
  createdAt DateTime @default(now())

  @@unique([storyId, viewHash])
  @@index([storyId])
}

// 3. Threaded Comments with 1-Level Nested Replies
model StoryComment {
  id          String   @id @default(cuid())
  storyId     String
  userId      String
  userName    String
  userAvatar  String?
  userRole    String?  @default("member") // 'member' | 'creator' | 'admin' | 'verified'
  content     String   @db.Text
  parentId    String?
  isPinned    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      StoryComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     StoryComment[]     @relation("CommentReplies")
  likes       StoryCommentLike[]

  @@index([storyId])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt])
}

// 4. Upvotes on Comments
model StoryCommentLike {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime     @default(now())

  comment   StoryComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// 5. Denormalized Cached Counters for Instant Reads
model StoryStats {
  storyId       String   @id
  likesCount    Int      @default(0)
  viewsCount    Int      @default(0)
  commentsCount Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// ==========================================
// 6. VIDEO LIKES (Unique per User & Video)
// ==========================================
model VideoLike {
  id        String   @id @default(cuid())
  videoId   String   // Canonical Video / Content ID
  userId    String   // Supabase Auth User UUID
  origin    String   @default("sawaflix") // 'sawaflix' | 'youtube'
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
  @@index([videoId])
  @@index([userId])
}

// ==========================================
// 7. VIDEO COMMENTS (Threaded & Moderated)
// ==========================================
model VideoComment {
  id         String             @id @default(cuid())
  videoId    String             // Canonical Video / Content ID
  userId     String             // Supabase Auth User UUID
  userName   String
  userAvatar String?
  userRole   String             @default("viewer") // 'viewer' | 'creator' | 'admin' | 'verified'
  content    String             @db.Text
  parentId   String?            // Enables nested replies ("comment on comment")
  isPinned   Boolean            @default(false)
  isDeleted  Boolean            @default(false) // Soft-delete for admin moderation
  likesCount Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  parent     VideoComment?      @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    VideoComment[]     @relation("VideoCommentReplies")
  likes      VideoCommentLike[]

  @@index([videoId])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// 8. UPVOTES ON COMMENTS
// ==========================================
model VideoCommentLike {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime     @default(now())

  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// ==========================================
// 9. VIDEO SHARES
// ==========================================
model VideoShare {
  id        String   @id @default(cuid())
  videoId   String
  userId    String?  // Optional: User might share while logged out
  platform  String   @default("web_share") // 'whatsapp' | 'twitter' | 'copy_link' | 'native'
  createdAt DateTime @default(now())

  @@index([videoId])
}

// ==========================================
// 10. VIDEO DOWNLOADS
// ==========================================
model VideoDownload {
  id        String   @id @default(cuid())
  videoId   String
  userId    String?
  mode      String   @default("direct_file") // 'direct_file' | 'offline_vault'
  createdAt DateTime @default(now())

  @@index([videoId])
}

// ==========================================
// 11. INSTANT DENORMALIZED COUNTERS (O(1) Reads)
// ==========================================
model VideoStats {
  videoId        String   @id
  likesCount     Int      @default(0)
  commentsCount  Int      @default(0)
  sharesCount    Int      @default(0)
  downloadsCount Int      @default(0)
  viewsCount     Int      @default(0)
  updatedAt      DateTime @updatedAt
}


